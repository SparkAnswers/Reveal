{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Reveal",
  "id": "sparkanswers-reveal-panel",
  "info": {
    "keywords": ["panel", "image", "countdown", "reveal", "teaser"],
    "description": "Progressively reveals an image or GIF as a date approaches: blur, pixelate, puzzle and more",
    "author": {
      "name": "SparkAnswers",
      "url": "https://github.com/SparkAnswers"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/SparkAnswers/reveal"
      },
      {
        "name": "License",
        "url": "https://github.com/SparkAnswers/reveal/blob/main/LICENSE"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/SparkAnswers/reveal/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Four reveal modes on a dashboard",
        "path": "img/screenshot-dashboard.png"
      },
      {
        "name": "LiveWire S2 telemetry with a scheduled bike reveal",
        "path": "img/screenshot-livewire.png"
      },
      {
        "name": "Micron DDR5 MRDIMM board with a scheduled memory reveal",
        "path": "img/screenshot-micron.png"
      },
      {
        "name": "Panel editor with live preview",
        "path": "img/screenshot-editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  },
  "skipDataQuery": true
}
